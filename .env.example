OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgres://user:pass@host:5432/dbname
PORT=3000
ALLOWED_ORIGIN=http://192.168.20.30

# TradingView scanner endpoint (server-side)
TRADINGVIEW_SCAN_URL=https://scanner.tradingview.com/global/scan2

# Optional fallback to legacy quote API when TV symbol not available
QUOTES_API_FALLBACK_URL=https://endpoapi-production-3202.up.railway.app/api/live-quotes

# Per-product symbol candidates (comma-separated; first matched will be used)
TV_SYMBOLS_GOLD=OANDA:XAUUSD
TV_SYMBOLS_OIL=ACTIVTRADES:BRENTM2026,TVC:UKOIL,TVC:USOIL
TV_SYMBOLS_HSI=VANTAGE:HK50,TVC:HSI
TV_SYMBOLS_NIKKEI=SPREADEX:NIKKEI,TVC:NI225
TV_SYMBOLS_AUDUSD=OANDA:AUDUSD
TV_SYMBOLS_EURUSD=OANDA:EURUSD
TV_SYMBOLS_GBPUSD=OANDA:GBPUSD
TV_SYMBOLS_USDCHF=OANDA:USDCHF
TV_SYMBOLS_USDJPY=OANDA:USDJPY

# Alias shown by app/output (optional)
TV_ALIAS_GOLD=XUL10
TV_ALIAS_OIL=BCO10_BBJ
TV_ALIAS_HSI=HKK50_BBJ
TV_ALIAS_NIKKEI=JPK50_BBJ
TV_ALIAS_AUDUSD=AU10F_BBJ
TV_ALIAS_EURUSD=EU10F_BBJ
TV_ALIAS_GBPUSD=GU10F_BBJ
TV_ALIAS_USDCHF=UC10F_BBJ
TV_ALIAS_USDJPY=UJ10F_BBJ
